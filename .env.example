# --- Telegram (обязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Polymarket (нужно только для реальных сделок; без ключа — только виртуально) ---
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=

# --- Источники сделок ---
# WebSocket RPC Polygon: можно несколько через запятую (слушаются параллельно,
# побеждает самый быстрый). Бесплатный публичный по умолчанию; для скорости и
# надёжности лучше свой ключ Alchemy / QuickNode / Infura / dRPC.
POLYGON_WSS_URLS=wss://polygon-bor-rpc.publicnode.com
CHAIN_ENABLED=true
RTDS_ENABLED=true
POLL_ENABLED=true
POLL_INTERVAL_SEC=2
DATA_API_MAX_RPS=6
AGGREGATE_WINDOW_MS=200
MAX_SIGNAL_AGE_SEC=60

# --- Хранилище (в Coolify подключи постоянный диск к /app/data) ---
DB_PATH=data/copy.db
REPORTS_DIR=data/reports
REPORT_INTERVAL_HOURS=4

# --- Поиск кошельков ---
DISCOVERY_RPS=3
DISCOVERY_QUICK_WALLETS=120
DISCOVERY_FULL_WALLETS=350
DISCOVERY_DRIFT_WALLETS=40
DISCOVERY_ARCHIVE_DETAIL=60
CENSUS_ENABLED=true
CENSUS_MIN_TRADE_USDC=50

LOG_LEVEL=INFO
