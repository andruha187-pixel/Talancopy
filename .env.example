# =====================================================================
# ⏱ Бот позднего входа 5m (Polymarket Up/Down) — переменные окружения.
# Локально — скопируй в .env, на Coolify — задай в Environment Variables.
#
# Обязательны только TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID (и POLY_PRIVATE_KEY
# для реальных ставок). Всё остальное — стартовые значения: дальше монеты,
# режим и правило входа меняются кнопками в Telegram (/menu) и хранятся в базе
# data/bot.db. Без постоянного тома на /app/data база при каждом деплое
# создаётся заново — и всё возвращается к значениям отсюда.
# =====================================================================

# --- Telegram (обязательно) ---
# Токен НОВОГО бота от @BotFather: один токен — один бот (с токеном бота серий
# оба будут мешать друг другу)
TELEGRAM_BOT_TOKEN=
# Твой chat id: туда идут уведомления и файлы, и только этот чат может управлять ботом
TELEGRAM_CHAT_ID=

# --- Кошелёк Polymarket (только для реальных ставок) ---
# Приватный ключ кошелька, которым торгуешь. ДЕРЖИ В СЕКРЕТЕ — лучше
# отдельный торговый кошелёк. Без ключа бот работает только в тесте.
POLY_PRIVATE_KEY=
# Нужен, только если торгуешь не с адреса этого ключа. Обычно — пусто.
POLY_FUNDER_ADDRESS=
# API-ключи CLOB для потока цен Chainlink (PolyBolt). Не заданы — бот выводит
# их из POLY_PRIVATE_KEY (только чтение). Без ключей — второй поток цен (RTDS).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Режим ---
# Общий выключатель реальных ставок (кнопка 🔴 Включить LIVE / 🧪 Выключить LIVE).
# true — ни одного реального ордера, что бы ни стояло у монет.
DRY_RUN=true

# --- Монеты ---
# Какие 5m-рынки бот пишет (все, даже выключенные — для подбора по архивам)
ASSETS=btc,eth,sol,xrp,bnb,doge,hype
# По каким ставит (✅) при старте. По умолчанию — лучшие на данных 25.09–20.10.
LATE_COINS=btc,eth,xrp,doge,bnb
# Какие сразу 🔴 — реальные ставки по ним, когда бот в 🔴 LIVE. Пусто — все 🧪.
# Пример: LATE_LIVE_COINS=btc,eth
LATE_LIVE_COINS=

# --- ⏱ Правило входа (всё это — кнопками и ✏️ в ⚙️ Настройках) ---
LATE_ENABLED=true
# Окно входа — секунд до конца окна: с LATE_FROM_SEC до LATE_TO_SEC (3:10 → 3:00).
# Одно время (ровно 3:00) — оба по 180.
LATE_FROM_SEC=190
LATE_TO_SEC=180
# Цена стороны-лидера (ask)
LATE_MIN_PRICE=0.92
LATE_MAX_PRICE=0.95
# Цена Chainlink ушла от страйка не меньше чем на столько процентов…
LATE_MIN_DIST_PCT=0.10
# …и не меньше чем на столько ATR (0 — без условия по ATR)
LATE_MIN_ATR=2.0
# Сумма входа, USDC (но не меньше 5 акций — меньший ордер биржа не берёт)
LATE_STAKE_USDC=5
# Дневной стоп реальных ставок, USDC (UTC-сутки; 0 — без стопа)
LATE_STOP_USDC=30
# Банк для монет со ставкой «% от банка» (🪙 → 💵), если баланс кошелька прочитать нельзя.
# 0 — не задан (тогда такие монеты ставят общую сумму). Свою сумму монете задаёшь кнопками.
LATE_BANK_USDC=0

# --- ATR: Wilder по 1-минутным свечам Binance ---
ATR_PERIOD=7
# Как часто пересчитывать ATR каждой монеты, секунд
ATR_REFRESH_SEC=10
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com

# --- 🔁 Запись окон (все монеты): путь цены для подбора по архивам ---
# Путь — с REC_FROM_SEC до REC_TO_SEC секунд до конца, каждые REC_STEP_SEC секунд
REC_FROM_SEC=270
REC_TO_SEC=5
REC_STEP_SEC=2
# Путь старше N дней стирается (страйк и исходы остаются; 0 — хранить всё)
REC_KEEP_DAYS=14

# --- Отчёты и база ---
# Раз в N часов — файлы в Telegram: окна (zip) и ставки (CSV)
REPORT_INTERVAL_HOURS=4
REPORTS_DIR=data/reports
# На Coolify: постоянный том (Persistent Storage) на /app/data — иначе база
# и настройки теряются при каждом деплое
DB_PATH=data/bot.db

# --- Технические (обычно не трогать) ---
POLY_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
# Живой стакан по WebSocket — без него ставок не будет
USE_LIVE_BOOK_STREAM=true
# Комиссия тейкера: ставка × FEE_RATE × (1 − цена)
FEE_RATE=0.07
# Цена Chainlink: страйк, текущая цена, конец окна. Старше N секунд — не входим.
CHAINLINK_MAX_AGE_SEC=5
CHAINLINK_USE_POLYBOLT=true
CHAINLINK_POLYBOLT_URL=wss://ws-live-v2.polymarket.com/ws
CHAINLINK_USE_RTDS=true
CHAINLINK_RTDS_URL=wss://ws-live-data.polymarket.com
