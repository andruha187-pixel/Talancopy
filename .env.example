# ============================================================
# Скопируй в .env и заполни своими значениями.
# НИКОГДА не коммить .env в git — он уже в .gitignore.
# ============================================================

# --- Активы ---
# Через запятую. На каждый актив заводится независимый поток на 5-минутном
# таймфрейме (см. src/timeframes.py), итого ASSETS потоков.
# HYPE убран (тонкий стакан). BNB и DOGE есть, но по умолчанию выключены (ENABLED_ASSETS).
ASSETS=btc,eth,sol,xrp,bnb,doge

# --- Источник цены/индикаторов (Binance, публичный API, ключ не нужен) ---
BINANCE_BASE_URL=https://api.binance.com
# Фолбэк для монет без спотовой пары на обычном Binance (на момент
# написания это под вопросом для HYPE — есть точно на фьючерсах).
BINANCE_FUTURES_URL=https://fapi.binance.com
# Цена потоком (WebSocket, сделки aggTrade) для быстрой проверки сигнала.
# Если сервер не достаёт до stream.binance.com, можно попробовать
# wss://data-stream.binance.vision (только рыночные данные).
BINANCE_WS_URL=wss://stream.binance.com:443
# Фьючерсный поток (для монет со свечами с фьючерсов, например HYPE).
# С 23.04.2026 у Binance это адрес /market, старый /stream отключён.
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market
ATR_LOOKBACK_FOR_REGIME=60

# --- Быстрая проверка сигнала (src/fast_signal.py) ---
# Кроме проверки раз в 3 с бот раз в FAST_LOOP_INTERVAL_SEC проверяет сигнал
# по цене Binance из потока и живому стакану — без запросов, те же условия
# входа. Включается/выключается и кнопкой ⚡ в ⚙️ Настройках (это значение —
# только для новой базы).
FAST_ENTRY_ENABLED=true
FAST_LOOP_INTERVAL_SEC=0.3

# Подтверждение сигнала: вход, только если сигнал был и ENTRY_CONFIRM_SEC
# секунд назад (в ту же сторону). Архив 25.09–11.10: проигрышей 7 → 1, прибыль
# +13%, входов на 37% меньше. Включается/выключается и кнопкой ⏱ в ⚙️
# Настройках (это значение — только для новой базы).
ENTRY_CONFIRM_ENABLED=true
ENTRY_CONFIRM_SEC=3

# Цена сигнала: chainlink — как Polymarket при расчёте исхода (цена и страйк
# Chainlink, Binance только для ATR/EMA/MACD), binance — как до 12.10.
# Переключается и кнопкой 📡 в ⚙️ Настройках.
PRICE_SOURCE=chainlink
# Цена Chainlink старше — входа нет
CHAINLINK_MAX_AGE_SEC=5
# Новый поток цен Polymarket (PolyBolt) требует API-ключи CLOB. Не заданы —
# бот возьмёт их из SDK или выведет из POLY_PRIVATE_KEY (только чтение уже
# существующих ключей). Старый поток (RTDS) работает без ключей, пока его не
# отключили; цены обоих складываются.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
CHAINLINK_USE_POLYBOLT=true
CHAINLINK_USE_RTDS=true

# --- Настройки 5-минутного таймфрейма (НЕПРОВЕРЕННЫЕ на реальных данных
# догадки, пропорционально пересчитанные из 15m-бота — присматривайся к
# первым отчётам особенно внимательно, это не откалиброванные значения) ---
# TF_5M_KLINE_INTERVAL=1m
# TF_5M_ATR_PERIOD=7
# TF_5M_EMA_FAST=3
# TF_5M_EMA_SLOW=7
# Окно входа меняется кнопкой ⏱ в ⚙️ Настройках; эти две переменные задают
# только значение для новой базы (рекомендованное 1–4.5 ставится само).
# TF_5M_MIN_MINUTES_LEFT=1
# TF_5M_MAX_MINUTES_LEFT=3.5
# TF_5M_ATR_DISTANCE_MULT=1.5
# TF_5M_ATR_SPIKE_MULT=2.2
# TF_5M_POLL_SECONDS=3

# --- Polymarket / CLOB ---
POLY_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
# Приватный ключ кошелька, которым торгуешь. ДЕРЖИ В СЕКРЕТЕ.
# Рекомендуется отдельный "торговый" кошелёк, а не основной.
POLY_PRIVATE_KEY=
# Нужен, только если торгуешь не с адреса, выведенного из приватного ключа
# (например, отдельный кошелёк на Polymarket). В большинстве случаев,
# включая email/Magic-логин, можно оставить пустым — SDK сам разберётся.
POLY_FUNDER_ADDRESS=
# Больше не используется (актуальный SDK polymarket-client сам определяет
# тип кошелька) — оставлено на случай отката на другой клиент.
POLY_SIGNATURE_TYPE=0

# --- Диапазон входа (общий; стартовое значение до первой настройки в Telegram) ---
# Свой диапазон и свою ставку у каждой монеты задаёт кнопка ⚙️ в 🪙 Активах —
# переменных окружения для этого нет, всё хранится в базе (/app/data).
MIN_ENTRY_PRICE=0.90
MAX_ENTRY_PRICE=0.95

# --- Пороги безопасности (общие; регулируется и кнопкой ⚙️ в Telegram) ---
SAFETY_SCORE_THRESHOLD=88
# Мин. расстояние цены от страйка, % от цены (0 = выкл). 0.05% ≈ $41 для BTC ~83k.
# По архивам до 10.10 срезал проигрыши примерно в 4 раза при той же прибыли.
MIN_DISTANCE_PCT=0.05
MIN_BOOK_LIQUIDITY_USDC=25

# --- Латентность исполнения ---
# Живой WS-стакан вместо REST-поллинга при каждом тике (см. src/book_stream.py).
USE_LIVE_BOOK_STREAM=true
# Запас на слиппедж поверх цены ask, увиденной на сигнале, на случай, если
# книга Polymarket успеет уйти за время между решением и отправкой ордера.
LIVE_ENTRY_MAX_SLIPPAGE=0.01
# Жёсткий потолок цены исполнения — даже с учётом слиппеджа никогда не
# платим больше этого, что бы ни случилось со стаканом. Максимум диапазона
# входа (общего и у монет) выше этого значения поставить нельзя.
MAX_ENTRY_EXECUTION_PRICE=0.97

# --- Управление капиталом (бот двух стратегий, с 14.10) ---
# Действуют для новой базы (после деплоя без постоянного тома база новая) —
# дальше меняются в Telegram и хранятся в /app/data.
# Ставка общая для виртуальных сделок и обеих стратегий: по умолчанию фикс. $1
# (стратегии новые — сначала малыми деньгами). Режим «% от банка»: банк =
# STARTING_BANKROLL_USDC + реальный результат с начала базы.
SIZING_MODE=fixed
TRADE_SIZE_USDC=1
BANKROLL_PCT=8
STARTING_BANKROLL_USDC=300
# Включённые монеты и монеты, по которым стратегиям можно входить реальными
# деньгами (🔴 LIVE в 🪙 Активах). По умолчанию реальных нет. Пример: LIVE_ASSETS=btc,sol
ENABLED_ASSETS=btc,eth,sol,xrp
LIVE_ASSETS=
# Свои диапазоны/ставки монет, JSON. Пусто — встроенные: у всех, кроме BTC,
# максимум 0.94.
# ASSET_OVERRIDES={"eth":{"min_entry_price":0.90,"max_entry_price":0.94}}
# Общий потолок ОДНОВРЕМЕННО открытых РЕАЛЬНЫХ позиций по всем монетам (только
# в ещё идущих рынках). Значение по умолчанию — дальше меняется кнопкой
# 📦 в ⚙️ Настройках.
MAX_OPEN_POSITIONS=8
# Ниже этой суммы даже не пытаемся входить — если в стакане меньше объёма
# по нужной цене, тик тихо пропускается (это не ошибка, просто неликвидно).
MIN_VIABLE_TRADE_USDC=2
DAILY_LOSS_LIMIT_USDC=60

# --- Масштабирование ставки по уверенности сигнала ---
# При score == порогу ставка = TRADE_SIZE_USDC * MIN_FRACTION; при score >=
# MAX_SCORE — полный TRADE_SIZE_USDC. Между ними — линейно. Включается/
# выключается кнопкой в Telegram (⚙️ Настройки), по умолчанию выключено.
SIZE_SCALING_MIN_FRACTION=0.3
SIZE_SCALING_MAX_SCORE=95

# --- Две стратегии (src/duo.py, с 14.10) ---
# Каждый сигнал — виртуальная сделка, реальные входы делают стратегии 1️⃣ и 2️⃣.
# false — обычный режим: сигнал = сделка (реальная по монетам с 🔴 LIVE).
STRATEGIES_MODE=true
# Фильтр расстояния от страйка (1.5 ATR и минимум в %). false — логика
# «сломанного» бота 12–14.10. Переключается и в ⚙️ Настройках.
DISTANCE_FILTER_ENABLED=false
# 1️⃣ Режим STRAT_A_MODE:
#   recover — отыгрыш: 2️⃣ проиграла по монете → один вход 1️⃣ по этой монете на
#             следующем сигнале на сумму, выигрыш с которой (минус комиссия)
#             возвращает минус 2️⃣. Не больше банка монеты, проиграл — повтора нет.
#   series  — после проигрыша монеты N входов по ней (проигрыш в серии — заново).
STRAT_A_ENABLED=true
STRAT_A_LIVE=false
STRAT_A_MODE=recover
STRAT_A_DEFAULT_N=2
# Свои N у монет (режим series), JSON. Пример: STRAT_A_COUNTS={"sol": 8, "btc": 2}
STRAT_A_COUNTS=
# Стартовый банк каждой монеты, USDC (свой — 🎯 Стратегии → 🏦). Банк = старт +
# итог сделок 1️⃣ и 2️⃣ этой монеты; реальный и тестовый считаются отдельно.
# Ставка «% банка» считается от него, и никакая ставка не больше банка монеты.
COIN_BANK_USDC=75
# Комиссия тейкера: ставка × FEE_RATE × (1 − цена) — для расчёта суммы отыгрыша.
FEE_RATE=0.07
# 2️⃣ Вход, только если за последние N минут не было проигрышей.
# STRAT_B_SCOPE: all — общая пауза на все монеты (по умолчанию), coin — у каждой своя.
STRAT_B_ENABLED=true
STRAT_B_LIVE=false
STRAT_B_PAUSE_MIN=60
STRAT_B_SCOPE=all
# Фильтры входа стратегий (0 — выкл): не позже чем за N минут до конца рынка и
# спред (ask фаворита + ask другой стороны − 1) не шире ENTRY_MAX_SPREAD.
ENTRY_MIN_MINUTES_LEFT=2
ENTRY_MAX_SPREAD=0
# Всё это — значения для новой базы; дальше меняется в Telegram (🎯 Стратегии).

# --- ⚡ Скорость рынка (только запись, ничего не покупает) ---
# Рывок: «честная» вероятность по цене Binance сдвинулась на ≥ SPEED_LAB_JUMP за
# ≤ SPEED_LAB_WINDOW_MS. Тогда пишется стакан Polymarket за 2 с до и
# SPEED_LAB_RECORD_MS после. Вкл/выкл — 🎯 Стратегии → ⚡ Скорость рынка.
SPEED_LAB_ENABLED=true
SPEED_LAB_JUMP=0.05
SPEED_LAB_WINDOW_MS=1000
SPEED_LAB_RECORD_MS=6000
SPEED_LAB_COOLDOWN_MS=3000
SPEED_LAB_KEEP_DAYS=3
# Другие биржи для сравнения (публичные потоки, без ключей): bnf — фьючерсы
# Binance, cb — Coinbase, okx — OKX, byb — Bybit. Пусто — без них.
SPEED_LAB_VENUES=bnf,cb,okx,byb

# --- 📚 Серии UP/DOWN (кнопка в 🎯 Стратегиях, только расчёт) ---
# Сколько дней свечей Binance брать и по какому ask считать ставку на разворот.
SERIES_HISTORY_DAYS=365
SERIES_ENTRY_PRICE=0.51

# --- Режим работы ---
# ОБЯЗАТЕЛЬНО прогони бота в DRY_RUN=true как минимум несколько дней и
# посмотри на signals в базе, прежде чем включать реальные сделки.
DRY_RUN=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DB_PATH=data/bot.db

# --- Отчёты для анализа стратегии ---
# Каждые N часов бот сам присылает в Telegram два CSV (сигналы + сделки)
# по ВСЕМ активам и таймфреймам разом — разбивка по колонкам asset/timeframe.
REPORT_INTERVAL_HOURS=4
REPORTS_DIR=data/reports

# --- Отслеживание чужого кошелька (уведомления + опциональный копитрейдинг) ---
WALLET_TRACK_ADDRESS=0x4707b735acce66b2ccb5600086de2329685cd1ce
WALLET_TRACK_POLL_SECONDS=3
